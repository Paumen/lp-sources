.rdw-embedded-modal-header-option { width: 50%; cursor: pointer; display: flex; justify-content: center; align-items: center; flex-direction: column; }

.rdw-embedded-modal-header-label { width: 95px; border-width: 1px 1px 2px; border-style: solid; border-color: rgb(241, 241, 241) rgb(241, 241, 241) rgb(10, 102, 183); border-image: none; margin-top: 5px; background: rgb(110, 184, 212); }

