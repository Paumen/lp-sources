.rdw-spinner > div { width: 12px; height: 12px; background-color: rgb(51, 51, 51); border-radius: 100%; display: inline-block; animation: 1.4s ease-in-out 0s infinite normal both running sk-bouncedelay; }

.rdw-spinner .rdw-bounce1 { animation-delay: -0.32s; }

