.rdw-option-wrapper { border: 1px solid rgb(241, 241, 241); padding: 5px; min-width: 25px; height: 20px; border-radius: 2px; margin: 0px 4px; display: flex; justify-content: center; align-items: center; cursor: pointer; background: rgb(255, 255, 255); text-transform: capitalize; }

.rdw-option-wrapper:hover { box-shadow: rgb(191, 189, 189) 1px 1px 0px; }

.rdw-option-wrapper:active { box-shadow: rgb(191, 189, 189) 1px 1px 0px inset; }

.rdw-option-active { box-shadow: rgb(191, 189, 189) 1px 1px 0px inset; }

.rdw-option-disabled { opacity: 0.3; cursor: default; }

.rdw-dropdown-wrapper { height: 30px; cursor: pointer; border: 1px solid rgb(241, 241, 241); border-radius: 2px; margin: 0px 3px; text-transform: capitalize; background: rgb(255, 255, 255); }

.rdw-dropdown-wrapper:focus { outline: 0px; }

.rdw-dropdown-wrapper:hover { box-shadow: rgb(191, 189, 189) 1px 1px 0px; background-color: rgb(255, 255, 255); }

.rdw-dropdown-wrapper:active { box-shadow: rgb(191, 189, 189) 1px 1px 0px inset; }

.rdw-dropdown-carettoopen { height: 0px; width: 0px; position: absolute; top: 35%; right: 10%; border-top: 6px solid rgb(0, 0, 0); border-left: 5px solid transparent; border-right: 5px solid transparent; }

.rdw-dropdown-carettoclose { height: 0px; width: 0px; position: absolute; top: 35%; right: 10%; border-bottom: 6px solid rgb(0, 0, 0); border-left: 5px solid transparent; border-right: 5px solid transparent; }

.rdw-dropdown-selectedtext { display: flex; position: relative; height: 100%; align-items: center; padding: 0px 5px; }

.rdw-dropdown-optionwrapper { z-index: 100; position: relative; border: 1px solid rgb(241, 241, 241); width: 98%; background: rgb(255, 255, 255); border-radius: 2px; margin: 0px; padding: 0px; max-height: 250px; overflow-y: scroll; }

.rdw-dropdown-optionwrapper:hover { box-shadow: rgb(191, 189, 189) 1px 1px 0px; background-color: rgb(255, 255, 255); }

.rdw-dropdownoption-default { min-height: 25px; display: flex; align-items: center; padding: 0px 5px; }

.rdw-dropdownoption-highlighted { background: rgb(241, 241, 241); }

.rdw-dropdownoption-active { background: rgb(245, 245, 245); }

.rdw-dropdownoption-disabled { opacity: 0.3; cursor: default; }

